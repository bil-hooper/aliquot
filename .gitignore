# Frontend (web/)
web/node_modules/
web/dist/
web/dist-ssr/
*.local

# Regenerable test fixture — `node scripts/generate-synthetic-graph.mjs` rebuilds it.
# Not source data, so it doesn't get the etl/aliquot.sqlite treatment (§8).
web/public/data/synthetic-skeleton.json

# ETL (etl/) — the SQLite file itself is the source of truth and IS committed (§8).
# Only the disk-backed HTTP cache and build output are excluded.
etl/.cache/
etl/bin/
etl/obj/

# Local secrets — Airtable key, HMAC shared secret, GitHub token (§1.7c). Never committed.
appsettings.Local.json
**/appsettings.Local.json
.env
.env.local

# Editor / OS
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
